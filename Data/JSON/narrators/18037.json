  "jarh_tadil": [
    {
      "scholar": "ابن حبان",
      "comment": "وذكره ابن حبان في الثقات، وقال: يروي عن حكيم بن جبير، وعنه أبو نعيم، وروى عنه أيضا إبراهيم بن الحسن الثعلبي، وجعفر بن حميد العبسي، وآخرون",
      "source": "[لسان الميزان (4/ 443)]"
    },
    {
      "scholar": "ابن عدي",
      "comment": "وهذا الحديث أيضا لا أعلم يرويه بهذا الإسناد غير عبد الله بن بكير",
      "source": "[الكامل في الضعفاء (5/ 410)]"
    },
    {
      "scholar": "ابن عدي",
      "comment": "وذكر له ابن عدي مناكير",
      "source": "[لسان الميزان (4/ 443)]"
    },
    {
      "scholar": "الساجي",
      "comment": "وقال الساجي: من أهل الصدق، وليس بقوي",
      "source": "[لسان الميزان (4/ 443)]"
    },
    {
      "scholar": "أبو حاتم الرازي",
      "comment": "قال أبو حاتم: كان من عتق الشيعة",
      "source": "[لسان الميزان (4/ 443)]"
