      "source": "[الكامل في الضعفاء (8/ 366)]"
    },
    {
      "scholar": "الذهبى",
      "comment": "وقد روى عنه أبو أمية الطرسوسي، وأبو بكر الأعين، فارتفعت الجهالة",
      "source": "[لسان الميزان (8/ 390)]"
    }
